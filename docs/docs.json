        "pages": ["agents", "runtime", "tools", "providers", "tracing"]
      },
      {
        "group": "Examples",
        "pages": [
          "examples/overview",
          "examples/quickstart",
          "examples/weather",
          "examples/tool-calling",
          "examples/multi-agent"
