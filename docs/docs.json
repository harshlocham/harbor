{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "Harbor",
  "colors": {
    "primary": "#0D9488",
    "light": "#5EEAD4",
    "dark": "#0B1F2A"
  },
  "favicon": "/favicon.svg",
  "logo": {
    "light": "/logo/light.svg",
    "dark": "/logo/dark.svg"
  },
  "navbar": {
    "links": [
      {
        "label": "GitHub",
        "href": "https://github.com/harshlocham/harbor"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Quick Start",
      "href": "/quickstart"
    }
  },
  "footer": {
