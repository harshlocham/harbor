{
  "name": "@harborts/providers",
  "version": "0.1.1",
  "description": "Model provider adapters for Harbor — OpenAI Chat Completions and message/tool mappers",
  "license": "MIT",
  "type": "module",
  "keywords": [
    "ai",
    "agents",
    "llm",
    "typescript",
    "openai",
    "provider",
    "harbor"
  ],
  "homepage": "https://github.com/harshlocham/harbor/tree/main/docs",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/harshlocham/harbor.git",
    "directory": "packages/providers"
  },
  "bugs": {
    "url": "https://github.com/harshlocham/harbor/issues"
  },
  "funding": {
    "type": "github",
    "url": "https://github.com/sponsors/harshlocham"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./openai": {
      "types": "./dist/openai/index.d.ts",
      "import": "./dist/openai/index.js",
      "require": "./dist/openai/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "clean": "rm -rf dist .tsbuild .turbo *.tsbuildinfo .tsbuildinfo",
    "dev": "tsup --watch",
    "lint": "eslint src --max-warnings 0",
    "test": "vitest run",
    "typecheck": "tsc -b --pretty false"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@harborts/core": "workspace:*",
    "@harborts/utils": "workspace:*",
    "openai": "^4.104.0"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "eslint": "catalog:",
    "tsup": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
