{
  "name": "@harbor/utils",
  "version": "0.0.0",
  "description": "Shared utilities for the Harbor AI agent SDK",
  "license": "MIT",
  "type": "module",
  "keywords": [
    "ai",
    "agents",
    "typescript",
    "utilities",
    "harbor"
  ],
  "homepage": "https://github.com/harshlocham/harbor#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/harshlocham/harbor.git",
    "directory": "packages/utils"
  },
  "bugs": {
    "url": "https://github.com/harshlocham/harbor/issues"
  },
  "funding": {
    "type": "github",
    "url": "https://github.com/sponsors/harshlocham"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "clean": "rm -rf dist .tsbuild .turbo *.tsbuildinfo .tsbuildinfo",
    "dev": "tsup --watch",
    "lint": "eslint src --max-warnings 0",
    "test": "vitest run",
    "typecheck": "tsc -b --pretty false"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "eslint": "catalog:",
    "tsup": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
